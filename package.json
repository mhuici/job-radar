{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small scheduled agent that finds remote engineering jobs and emails a filtered digest to each profile.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dry-run": "DRY_RUN=1 tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
